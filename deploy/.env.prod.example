# CNN-BTPManager-Pro — variables de production (VPS)
#
# Copier en `.env` sur le VPS, puis remplir. Ce fichier ne doit JAMAIS
# être commité (deploy/.env est dans .gitignore).
#
#   cp .env.prod.example .env && nano .env

# ── Domaine ───────────────────────────────────────────────────────────
# Doit pointer (enregistrement A) vers l'IP publique du VPS.
# Caddy obtient le certificat HTTPS automatiquement, et redirige
# www.<domaine> vers <domaine>.
DOMAIN=cnn-btpmanager.com

# ── Base de données ───────────────────────────────────────────────────
POSTGRES_DB=cnn_btp
POSTGRES_USER=cnn
# Générer : openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Secrets JWT ───────────────────────────────────────────────────────
# Générer chacun séparément : openssl rand -base64 48
# Ils DOIVENT être différents l'un de l'autre.
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Limitation de débit ───────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Sauvegardes ───────────────────────────────────────────────────────
# Nombre de jours de conservation des dumps quotidiens.
BACKUP_RETENTION_DAYS=30
